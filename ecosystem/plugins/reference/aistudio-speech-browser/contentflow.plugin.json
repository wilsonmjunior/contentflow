{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "local.contentflow.aistudio-speech-browser",
  "name": "Google AI Studio Speech",
  "version": "1.0.0",
  "description": "Gera narração de áudio na página Generate Speech do Google AI Studio com Gemini TTS, voz configurável e download WAV pela sessão autenticada.",
  "author": "André Marinho Jr.",
  "license": "MIT",
  "branding": {
    "iconPath": "assets/icon.png"
  },
  "homepage": "https://aistudio.google.com/generate-speech",
  "repository": "https://github.com/andremjr/plugins-contentflow",
  "runtime": {
    "kind": "node",
    "version": ">=26 <27",
    "module": "esm"
  },
  "minCoreVersion": "1.3.3",
  "entrypoint": "handler.mjs",
  "browserRuntime": {
    "lifecycle": "core"
  },
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "process"
  ],
  "networkHosts": [
    "aistudio.google.com",
    "generativelanguage.googleapis.com",
    "googleusercontent.com",
    "googleapis.com"
  ],
  "profileSetup": {
    "configurationKey": "accountProfile",
    "fallbackConfigurationKey": "fallbackAccountProfiles",
    "label": "Salvar perfil",
    "description": "Abre o Google AI Studio para login e fecha o Chrome após validar a página Generate Speech."
  },
  "localizations": {
    "en": {
      "name": "Google AI Studio Speech",
      "description": "Generates narration audio on Google AI Studio Generate Speech with Gemini TTS, configurable voice, and WAV download from the authenticated session.",
      "profileSetup": {
        "label": "Save profile",
        "description": "Opens Google AI Studio for sign-in and closes Chrome after validating the Generate Speech page."
      },
      "capabilities": {
        "generate-speech-in-browser": {
          "name": "Generate speech",
          "description": "Turns a script into narration audio on AI Studio.",
          "inputPorts": {
            "text": {
              "label": "Script to narrate",
              "description": "Exact text spoken by the selected voice."
            }
          },
          "outputPorts": {
            "audio": {
              "label": "Narration",
              "description": "WAV audio generated by Gemini TTS."
            },
            "metadata": {
              "label": "Generation metadata"
            }
          },
          "blockConfigSchema": {
            "properties": {
              "accountProfile": { "title": "Account profile" },
              "fallbackAccountProfiles": {
                "title": "Fallback profiles",
                "description": "Additional aliases, one per line, in usage order."
              },
              "model": { "title": "TTS model" },
              "voice": { "title": "Voice" },
              "styleInstructions": {
                "title": "Style instructions",
                "description": "Optional delivery guidance such as tone, pace, and emotion. When empty, the block instruction is used."
              },
              "startMinimized": { "title": "Start minimized" }
            }
          }
        }
      }
    },
    "es": {
      "name": "Google AI Studio Speech",
      "description": "Genera narración de audio en Generate Speech de Google AI Studio con Gemini TTS, voz configurable y descarga WAV desde la sesión autenticada.",
      "profileSetup": {
        "label": "Guardar perfil",
        "description": "Abre Google AI Studio para iniciar sesión y cierra Chrome tras validar la página Generate Speech."
      },
      "capabilities": {
        "generate-speech-in-browser": {
          "name": "Generar narración",
          "description": "Convierte un guion en audio de narración en AI Studio.",
          "inputPorts": {
            "text": {
              "label": "Guion para narrar",
              "description": "Texto exacto que leerá la voz seleccionada."
            }
          },
          "outputPorts": {
            "audio": {
              "label": "Narración",
              "description": "Audio WAV generado por Gemini TTS."
            },
            "metadata": {
              "label": "Metadatos de la generación"
            }
          },
          "blockConfigSchema": {
            "properties": {
              "accountProfile": { "title": "Perfil de cuenta" },
              "fallbackAccountProfiles": {
                "title": "Perfiles de respaldo",
                "description": "Alias adicionales, uno por línea, en orden de uso."
              },
              "model": { "title": "Modelo TTS" },
              "voice": { "title": "Voz" },
              "styleInstructions": {
                "title": "Instrucciones de estilo",
                "description": "Guía opcional de tono, ritmo y emoción. Si está vacío, se usa la instrucción del bloque."
              },
              "startMinimized": { "title": "Iniciar minimizado" }
            }
          }
        }
      }
    }
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chromeExecutable": {
        "type": "string",
        "default": "",
        "description": "Caminho opcional do Google Chrome. Vazio detecta automaticamente."
      },
      "profilesBasePath": {
        "type": "string",
        "default": "",
        "description": "Pasta-base opcional. Vazio usa o workspace autorizado do plugin."
      },
      "allowExistingChromeProfile": {
        "type": "boolean",
        "default": false,
        "description": "Permite usar uma pasta de perfil Chrome existente escolhida explicitamente."
      },
      "remoteDebuggingPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 64000,
        "default": 9744
      },
      "keepBrowserOpen": {
        "type": "boolean",
        "default": true
      },
      "startMinimized": {
        "type": "boolean",
        "default": true
      },
      "interactiveWaitSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 600
      },
      "responseTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 600
      },
      "diagnosticTrace": {
        "type": "boolean",
        "default": false
      },
      "diagnosticFixture": {
        "type": "boolean",
        "default": false,
        "description": "Somente para testes determinísticos; não abre o navegador."
      }
    }
  },
  "capabilities": [
    {
      "id": "generate-speech-in-browser",
      "operator": "IA",
      "instructionUsage": "optional",
      "blockTypes": ["CRIAR"],
      "processTypes": ["narration", "assets", "editing"],
      "inputPorts": [
        {
          "key": "text",
          "label": "Texto para narrar",
          "description": "Texto literal enviado ao Gemini TTS na página Generate Speech.",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        }
      ],
      "outputPorts": [
        {
          "key": "audio",
          "label": "Narração",
          "description": "Arquivo WAV gerado pelo Google AI Studio.",
          "required": true,
          "presentation": {
            "renderer": "audio-player"
          },
          "shape": {
            "kind": "content",
            "family": "audio",
            "cardinality": "one",
            "representation": "artifact",
            "formats": {
              "mimeTypes": ["audio/wav", "audio/x-wav", "audio/mpeg", "audio/mp4"],
              "extensions": ["wav", "mp3", "m4a"]
            }
          }
        },
        {
          "key": "metadata",
          "label": "Metadados da geração",
          "required": false,
          "presentation": {
            "renderer": "table"
          },
          "shape": {
            "kind": "record",
            "cardinality": "many",
            "fields": []
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["external_write", "local_artifact", "subprocess"],
      "cost": {
        "model": "unknown",
        "estimateSupported": false
      },
      "dataPolicy": {
        "sendsDataToThirdParties": true,
        "providers": ["Google AI Studio / Gemini TTS"]
      },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fallbackAccountProfiles": {
            "type": "string",
            "title": "Perfis de fallback",
            "format": "textarea",
            "default": "",
            "maxLength": 512,
            "description": "Aliases adicionais, um por linha, em ordem."
          },
          "accountProfile": {
            "type": "string",
            "title": "Perfil da conta",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "default": "default"
          },
          "model": {
            "type": "string",
            "title": "Modelo TTS",
            "enum": [
              "gemini-3.8-flash-tts",
              "gemini-3.8-flash-lite-tts",
              "gemini-3.1-flash-tts-preview",
              "gemini-2.5-pro-preview-tts",
              "gemini-2.5-flash-preview-tts"
            ],
            "default": "gemini-3.8-flash-tts"
          },
          "voice": {
            "type": "string",
            "title": "Voz",
            "enum": [
              "Zephyr",
              "Puck",
              "Charon",
              "Kore",
              "Fenrir",
              "Leda",
              "Orus",
              "Aoede",
              "Callirrhoe",
              "Autonoe",
              "Enceladus",
              "Iapetus",
              "Umbriel",
              "Algieba",
              "Despina",
              "Erinome",
              "Algenib",
              "Rasalgetir",
              "Laomedeia",
              "Achernar",
              "Alnilam",
              "Schedar",
              "Gacrux",
              "Pulcherrima",
              "Achird",
              "Zubenelgenubi",
              "Vindemiatrix",
              "Sadachbia",
              "Sadaltager",
              "Sulafat"
            ],
            "default": "Kore"
          },
          "styleInstructions": {
            "type": "string",
            "title": "Instruções de estilo",
            "format": "textarea",
            "default": "",
            "maxLength": 4000,
            "description": "Tom, ritmo e emoção. Vazio usa a instrução do bloco, se houver."
          },
          "startMinimized": {
            "type": "boolean",
            "title": "Iniciar minimizado",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audio": { "type": "object" },
          "metadata": { "type": "array" }
        },
        "required": ["audio"]
      }
    }
  ]
}
